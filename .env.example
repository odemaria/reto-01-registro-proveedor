# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.
# Bun carga .env automáticamente.

# ── Proveedor de lenguaje ──
# auto (por defecto): Gemini si hay GEMINI_API_KEY; si no, Anthropic si hay ANTHROPIC_API_KEY; si no, "simulado".
# Valores posibles: auto | gemini | anthropic | simulado
LLM_PROVIDER=auto

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Solo la lee el backend; nunca llega al front, a los logs ni a las respuestas de la API.
GEMINI_API_KEY=

# Opcional: proveedor alternativo (Anthropic). No es necesario para ejecutar el proyecto.
ANTHROPIC_API_KEY=

# Vacío = modelo por defecto del proveedor: gemini-2.5-flash (capa gratuita) o claude-opus-5-5.
LLM_MODEL=
# Nivel de razonamiento: minimal | low | medium | high | xhigh | max.
# Vacío = "low" en Gemini (más rápido en la capa gratuita) y "medium" en Anthropic.
LLM_EFFORT=
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS_RESPUESTA=16000

# ── Límites de costo y uso ──
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_MENSAJES_POR_MINUTO=20
MAX_SESIONES=200

# ── Reglas del proceso ──
# Fecha (AAAA-MM-DD) contra la que se evalúan las vigencias de los soportes.
# Vacía = fecha del sistema. 2026-09-03 es la fecha del PRD y reproduce los escenarios esperados.
FECHA_REFERENCIA=2026-09-03

# ── Servidor ──
PORT=3000
# Opcional: si se define, el chat pide esta clave de acceso (header x-clave-acceso).
APP_ACCESS_KEY=
